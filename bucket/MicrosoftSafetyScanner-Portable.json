            "hash": "c33f392f27e5c78aab5964d402ac8e6ab85654f54fbd84cb619400379c16e688"
        },
        "32bit": {
            "url": "https://definitionupdates.microsoft.com/packages/content/msert.exe?packageType=Scanner&packageVersion=1.457.280.0&arch=x86",
