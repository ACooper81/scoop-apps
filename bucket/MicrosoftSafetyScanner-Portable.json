            "hash": "aefe2a3812bd79b840802a45f71c6456714f4b94b4b46847c95cbd194960c711"
        },
        "32bit": {
            "url": "https://definitionupdates.microsoft.com/packages/content/msert.exe?packageType=Scanner&packageVersion=1.459.77.0&arch=x86",
