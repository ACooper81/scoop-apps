            "hash": "6a2dfe2037e3c90ba17e97445437cc02954af02ba4209cbe52771fa0d6220f8c"
        },
        "32bit": {
            "url": "https://definitionupdates.microsoft.com/packages/content/msert.exe?packageType=Scanner&packageVersion=1.457.118.0&arch=x86",
