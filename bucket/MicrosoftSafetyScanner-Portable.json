            "hash": "a977a9cbb3ea59f7f6113751cf388d9daded9c9ac556a22765271af146122870"
        },
        "32bit": {
            "url": "https://definitionupdates.microsoft.com/packages/content/msert.exe?packageType=Scanner&packageVersion=1.455.462.0&arch=x86",
