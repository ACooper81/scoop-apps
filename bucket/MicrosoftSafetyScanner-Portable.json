            "hash": "931c606c6cf0b9164acce154fc5db3eaad4905386a8c77010d236ada0c603365"
        },
        "32bit": {
            "url": "https://definitionupdates.microsoft.com/packages/content/msert.exe?packageType=Scanner&packageVersion=1.459.109.0&arch=x86",
